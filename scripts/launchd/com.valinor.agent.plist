<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.valinor.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>@VALINOR_BINARY@</string>
		<string>run</string>
		<string>--mode=@VALINOR_MODE@</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>@VALINOR_STDOUT_LOG@</string>
	<key>StandardErrorPath</key>
	<string>@VALINOR_STDERR_LOG@</string>
</dict>
</plist>