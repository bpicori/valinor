# Valinor Sandbox Container
# This container provides a secure execution environment for all tool commands.
# The workspace is bind-mounted at /workspace.

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install essential tools for development tasks
RUN apt-get update && apt-get install -y \
    bash \
    coreutils \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    ripgrep \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js and npm (includes npx)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install browser automation dependencies
RUN apt-get update && apt-get install -y \
    libglib2.0-0t64 \
    libnspr4 \
    libnss3 \
    libatk1.0-0t64 \
    libatk-bridge2.0-0t64 \
    libdbus-1-3 \
    libcups2t64 \
    libxkbcommon0 \
    libatspi2.0-0t64 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libcairo2 \
    libpango-1.0-0 \
    libasound2t64 \
    && rm -rf /var/lib/apt/lists/*

# Create the workspace directory (will be bind-mounted from host)
WORKDIR /workspace

# Default command keeps the container running
# The actual commands are executed via 'podman exec'
CMD ["sleep", "infinity"]
