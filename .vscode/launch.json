    "version": "0.2.0",
    "configurations": [
        {
            "name": "Gateway",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/valinor",
            "args": ["run", "--mode=gateway"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "TUI",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/valinor",
            "args": ["run", "--mode=tui", "--identity=debug"],
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Telegram",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/valinor",
            "args": ["run", "--mode=telegram"],
            "cwd": "${workspaceFolder}"
        }
    ]
}